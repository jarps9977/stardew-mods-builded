			"Action": "EditData",
			"Target": "Data/Festivals/spring13",
			"Entries": 
			{ "GetoSuguru_spouse": "I'm rooting for you, my love.$1#$b#Now, beat 'em! Don't let all that training go to waste.$9#$b#But losing or winning... I'm proud of you either way.$6",
			  "GetoSuguru_spouse_y2": "I helped with decorating the eggs this year!$1#$b#Let's see if you can spot the eggs with my doodles on them, love.$9"
			
