{
   "Format": "2.0.0",
   "Changes": [
    // Load as new assets instead of overwriting vanilla pet textures.
    {"Action": "Load",
      "Target": "Mods/{{ModId}}/Cat0",
      "FromFile": "assets/Animals/cat.png"
      },
    {"Action": "Load",
      "Target": "Mods/{{ModId}}/Cat1",
      "FromFile": "assets/Animals/cat1.png"
      },
    {"Action": "Load",
      "Target": "Mods/{{ModId}}/Cat2",
      "FromFile": "assets/Animals/cat2.png"
      },
    {"Action": "Load",
      "Target": "Mods/{{ModId}}/Dog0",
      "FromFile": "assets/Animals/dog.png"
      },
    {"Action": "Load",
      "Target": "Mods/{{ModId}}/Dog1",
      "FromFile": "assets/Animals/dog1.png"
      },
    {"Action": "Load",
      "Target": "Mods/{{ModId}}/Dog2",
      "FromFile": "assets/Animals/dog2.png"
      },
    {"Action": "Load",
      "Target": "Mods/{{ModId}}/Icons",
      "FromFile": "assets/LooseSprites/z_Cursors.png"
      },

    // Add as extra breeds; selectable at character creation and from Marnie.
    {"Action": "EditData",
      "Target": "Data/Pets",
      "TargetField": [ "Cat", "Breeds" ],
      "Entries": {
        "{{ModId}}_Cat0": { "Id": "{{ModId}}_Cat0", "Texture": "Mods/{{ModId}}/Cat0", "IconTexture": "Mods/{{ModId}}/Icons", "IconSourceRect": { "X": 0, "Y": 0, "Width": 16, "Height": 16 } },
        "{{ModId}}_Cat1": { "Id": "{{ModId}}_Cat1", "Texture": "Mods/{{ModId}}/Cat1", "IconTexture": "Mods/{{ModId}}/Icons", "IconSourceRect": { "X": 16, "Y": 0, "Width": 16, "Height": 16 } },
        "{{ModId}}_Cat2": { "Id": "{{ModId}}_Cat2", "Texture": "Mods/{{ModId}}/Cat2", "IconTexture": "Mods/{{ModId}}/Icons", "IconSourceRect": { "X": 32, "Y": 0, "Width": 16, "Height": 16 } }
      }
      },
    {"Action": "EditData",
      "Target": "Data/Pets",
      "TargetField": [ "Dog", "Breeds" ],
      "Entries": {
        "{{ModId}}_Dog0": { "Id": "{{ModId}}_Dog0", "Texture": "Mods/{{ModId}}/Dog0", "IconTexture": "Mods/{{ModId}}/Icons", "IconSourceRect": { "X": 48, "Y": 0, "Width": 16, "Height": 16 } },
        "{{ModId}}_Dog1": { "Id": "{{ModId}}_Dog1", "Texture": "Mods/{{ModId}}/Dog1", "IconTexture": "Mods/{{ModId}}/Icons", "IconSourceRect": { "X": 64, "Y": 0, "Width": 16, "Height": 16 } },
        // Icon sheet is 95px wide, so the last icon is 15px.
        "{{ModId}}_Dog2": { "Id": "{{ModId}}_Dog2", "Texture": "Mods/{{ModId}}/Dog2", "IconTexture": "Mods/{{ModId}}/Icons", "IconSourceRect": { "X": 80, "Y": 0, "Width": 15, "Height": 16 } }
      }
      }
 ]
}
